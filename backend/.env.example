APP_ENV=development

# ---------------------------------------------------------------- Banco
# Local (Docker Compose): docker compose -f ../docker-compose.yml up -d
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/sgopi
# Supabase (demo): comente a linha acima e descomente/preencha esta
# DATABASE_URL=postgresql+asyncpg://postgres:<senha>@<host>.supabase.co:5432/postgres
DATABASE_ECHO=false

# ---------------------------------------------------------------- Segurança (RNF02*)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-esta-chave-em-qualquer-ambiente-que-nao-seja-dev
JWT_EXPIRES_IN_HOURS=8
# Origens permitidas no CORS (separadas por vírgula) — nunca "*"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ---------------------------------------------------------------- Tempo real / despacho
TELEMETRIA_MAX_IDADE_SEGUNDOS=60
SIMULADOR_INTERVALO_SEGUNDOS=1.0
SIMULADOR_RAIO_METROS=150
# Issue #54 (RF02): viatura despachada navega até a ocorrência (vazio = linha reta, sem rede)
SIMULADOR_PASSO_DESTINO_METROS=300
SIMULADOR_RAIO_CHEGADA_METROS=50
SIMULADOR_JITTER_CHEGADA_METROS=5
# Issue #66 (RF02): serviço de rotas. Vazio = linha reta, sem rede.
SIMULADOR_ROTEADOR_URL=https://router.project-osrm.org
# Timeout da consulta de rota: um estouro aciona um backoff global de 30s que joga a frota
# inteira para linha reta, então o valor precisa absorver a latência de cache frio do serviço.
SIMULADOR_ROTEADOR_TIMEOUT_SEGUNDOS=5.0
# Sem resolvedor em lote, a viatura despachada avança em linha reta nesta velocidade
SIMULADOR_VELOCIDADE_KMH=120
# RF18/RF19: distância da ocorrência em que a telemetria considera a viatura "no local"
DESPACHO_RAIO_CHEGADA_METROS=50
DESPACHO_QTD_SUGESTOES=3

# ---------------------------------------------------------------- Despacho automático (Issues #62/#63)
# Opt-in, desligado por padrão. Liga o orquestrador junto com /v1/simulador/ligar:
# despacha a viatura DISPONIVEL mais próxima de cada ocorrência VALIDADA parada além
# da carência, e encerra a ocorrência após a chegada + tempo de atendimento.
# Exige os usuários 'simulador-operador' (despacha) e 'simulador-delegado' (encerra) do seed.
# Nunca ativo em testes automatizados.
DESPACHO_AUTOMATICO_LIGADO=false
ORQUESTRADOR_INTERVALO_SEGUNDOS=5
JANELA_CARENCIA_SEGUNDOS=20
TEMPO_ATENDIMENTO_SEGUNDOS=45

# ---------------------------------------------------------------- Gerador demo (Issue #55 / RF01)
# Opt-in, desligado por padrão. Quando ligado, cria 1 ocorrência fictícia
# AGUARDANDO_REVISAO marcada com [SIMULADO-DEMO] (autor simulador-demo) a cada
# intervalo, para a Fila do Delegado (após refresh). Painel/heatmap só refletem
# após validação manual. Mínimo 1s. Limpeza: reset do banco demo + seed.
GERADOR_OCORRENCIAS_LIGADO=false
GERADOR_OCORRENCIAS_INTERVALO_SEGUNDOS=120

# ---------------------------------------------------------------- Evidências (RF01)
EVIDENCIAS_DIRETORIO=storage/evidencias
EVIDENCIAS_TAMANHO_MAXIMO_BYTES=10485760

# ---------------------------------------------------------------- Observabilidade
LOG_JSON=true
LOG_LEVEL=INFO
