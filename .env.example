# Segredo usado para assinar o cookie de sessão (HMAC-SHA256). Troque em produção.
SESSION_SECRET=troque-este-segredo-em-producao

# Token exigido pelo endpoint de telemetria (POST /api/viaturas/:id/telemetria).
# O simulador interno usa o mesmo valor.
TELEMETRIA_TOKEN=token-telemetria-dev

# Liga/desliga o simulador de GPS embutido (RNF01). "true" | "false"
GPS_SIMULADOR_ATIVO=true

# Intervalo (ms) entre emissões de posição do simulador.
GPS_SIMULADOR_INTERVALO_MS=2000
